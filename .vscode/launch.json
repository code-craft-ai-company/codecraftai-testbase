{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Python: Internal UnitTest Tests - run",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "discover",
                "-s",
                "source/tests"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python: Internal Tests - Run",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/source/packages/automojo/testbase/cli/testbase_command.py",
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "testing",
                "run",
                "--root=${workspaceFolder}/source/testroots/automojo",
                "--includes=automojo.tests"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python: Internal Tests - Query",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/source/packages/automojo/testbase/cli/testbase_command.py",
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "testing",
                "query",
                "--root=${workspaceFolder}/source/testroots/automojo",
                "--includes=automojo.tests"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python: Test Results",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/source/packages/automojo/testbase/cli/testbase_command.py",
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "services",
                "results"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python: Test Rendering",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/source/packages/automojo/testbase/cli/testbase_command.py",
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "services",
                "results",
                "--directory=${workspaceFolder}/source/testroots/report-tests"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}